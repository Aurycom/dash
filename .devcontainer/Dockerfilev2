FROM node:22-bookworm-slim

# Arguments pour l'utilisateur non-root
ARG USERNAME=dev
ARG USER_UID=1001
ARG USER_GID=$USER_UID

# 1. Installation des outils système (on garde uniquement le nécessaire pour C++ et git)
RUN apt-get update && export DEBIAN_FRONTEND=noninteractive \
    && apt-get install -y --no-install-recommends \
        build-essential \
        gdb \
        cmake \
        git \
        curl \
        sudo \
        alsa-utils \
        cmake \
        libboost-all-dev \
        libusb-1.0-0-dev \
        libssl-dev \
        libprotobuf-dev \
        protobuf-c-compiler \
        protobuf-compiler \
        libqt5multimedia5 \
        libqt5multimedia5-plugins \
        libqt5multimediawidgets5 \
        qtmultimedia5-dev \
        libqt5bluetooth5 \
        libqt5bluetooth5-bin \
        qtconnectivity5-dev \
        pulseaudio \
        pulseaudio-module-bluetooth \
        librtaudio-dev \
        librtaudio6 \
        libkf5bluezqt-dev \
        libtag1-dev \
        qml-module-qtquick2 \
        libglib2.0-dev \
        libgstreamer1.0-dev \
        gstreamer1.0-plugins-base-apps \
        gstreamer1.0-plugins-bad \
        gstreamer1.0-libav \
        gstreamer1.0-alsa \
        libgstreamer-plugins-base1.0-dev \
        qtdeclarative5-dev \
        libgstreamer-plugins-bad1.0-dev \
        libunwind-dev \
        qml-module-qtmultimedia \
        libqt5serialbus5-dev \
        libqt5serialbus5-plugins \
        libqt5serialport5-dev \
        libqt5websockets5-dev \
        libqt5svg5-dev \
        build-essential \
        libtool \
        autoconf \
        ffmpeg \
        libgpiod-dev \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Création propre de l'utilisateur avec son dossier home (-m)
RUN groupadd --gid $USER_GID $USERNAME \
    && useradd --uid $USER_UID --gid $USER_GID -m -s /bin/bash $USERNAME \
    && echo "$USERNAME ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/$USERNAME \
    && chmod 0440 /etc/sudoers.d/$USERNAME

# Passage à l'utilisateur
USER $USERNAME
WORKDIR /home/$USERNAME

# Sécurité : s'assurer que le dossier .npm-global lui appartient à 100% avant d'exécuter npm
RUN mkdir -p /home/$USERNAME/.npm-global \
    && npm config set prefix '/home/$USERNAME/.npm-global'

# Installation globale
RUN npm install -g @anthropic-ai/claude-code

ENV PATH="/home/$USERNAME/.npm-global/bin:${PATH}"
WORKDIR /workspace
