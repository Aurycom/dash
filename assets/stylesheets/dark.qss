QMainWindow#DarkMode,
QMainWindow#DarkMode > QFrame {
    background-color: rgb(18, 18, 18);
}

#DarkMode QWidget {
    outline: 0;
}

#DarkMode QLabel {
    color: rgb(255, 255, 255);
}

#DarkMode QLabel:disabled {
    color: rgba(255, 255, 255, 128);
}

#DarkMode QTabWidget::pane {
    background-color: transparent;
    border: none;
    border-top: 2px solid rgb(66, 66, 66);
}

#DarkMode QTabBar::tab {
    background-color: transparent;
    color: rgba(255, 255, 255, 179);
    margin-top: 2px;
    padding: 2px;
    border-bottom: 2px solid transparent;
}

#DarkMode QTabBar::tab:selected:top {
    color: palette(base);
    border-bottom: 2px solid palette(base);
}

#DarkMode QTabBar::tab:disabled {
    height: 0px;
    width: 0px;
    padding: 0px;
    margin: 0px;
}

#DarkMode QSlider {
    height: 30px;
}

#DarkMode QSlider::groove {
    background-color: palette(alternate-base);
    height: 5px;
    border-radius: 2px;
}

#DarkMode QSlider::groove[neutral="true"] {
    background-color: rgba(224, 224, 224, 128);
}

#DarkMode QSlider::handle {
    background-color: palette(base);
    width: 25px;
    height: 5px;
    line-height: 26px;
    margin-top: -10px;
    margin-bottom: -10px;
    border-radius: 12px;
}

#DarkMode QSlider::handle[neutral="true"] {
    background-color: rgb(224, 224, 224);
}

#DarkMode QSlider::sub-page {
    background-color: palette(base);
    height: 5px;
    border-radius: 2px;
}

#DarkMode QSlider::sub-page[neutral="true"] {
    background-color: rgb(224, 224, 224);
}

#DarkMode QPushButton {
    color: rgb(255, 255, 255);
    border: none;
    padding: 8px;
    border-radius: 8px;
}

#DarkMode QPushButton:pressed {
    background-color: rgba(255, 255, 255, 25);
}

#DarkMode QPushButton:disabled {
    color: rgba(255, 255, 255, 128);
}

#DarkMode QPushButton:!flat {
    background-color: rgb(50, 50, 50);
}

#DarkMode QPushButton:!flat:checked {
    color: rgb(0, 0, 0);
    background-color: palette(base);
}

#DarkMode QPushButton:!flat:disabled {
    background-color: rgb(33, 33, 33);
}

#DarkMode QPushButton#FullscreenBar {
    border-radius: 2px;
    margin: 2px;
}

#DarkMode QFrame[frameShape="4"][frameShadow="16"],
#DarkMode QFrame[frameShape="5"][frameShadow="16"] {
    color: rgba(255, 255, 255, 66);
}

#DarkMode QListWidget {
    background-color: rgb(46, 46, 46); 
    color: rgb(255, 255, 255);
    border: 2px solid rgb(66, 66, 66);
}

#DarkMode QListView {
    padding: 2px;
    border-radius: 8px;
}

#DarkMode QListView::indicator {
    border: none;
}

#DarkMode QListView::item:selected {
    color: rgb(0, 0, 0);
    background-color: palette(base);
    border-radius: 8px;
}

#DarkMode QListView::item:disabled {
    color: rgba(255, 255, 255, 128);
}

#DarkMode QGroupBox {
    border: none;
}

#DarkMode QCheckBox {
    color: rgb(255, 255, 255);
    background-color: transparent;
}

#DarkMode QRadioButton {
    color: rgb(255, 255, 255);
    background-color: transparent;
}

#DarkMode QRadioButton:disabled {
    color: rgb(136, 136, 136);
}

#DarkMode QCheckBox::indicator {
    width: 22px;
    height: 22px;
    border: 2px solid rgb(255, 255, 255);
    border-radius: 3px;
}

#DarkMode QRadioButton::indicator {
    width: 19px;
    height: 19px;
    border: 2px solid rgb(255, 255, 255);
    border-radius: 11px;
}

#DarkMode QRadioButton::indicator:disabled {
    border: 2px solid rgb(136, 136, 136);
}

#DarkMode QCheckBox::indicator::checked {
    image: url(:/icons/dark/check.svg);
    background-color: palette(base);
    border: 2px solid palette(base);
}

#DarkMode QRadioButton::indicator::checked {
    background-color: qradialgradient(cx:0.5, cy:0.5, fx:0.5, fy:0.5, radius:.4, stop:.65 palette(base), stop:.75 transparent);
    border: 2px solid palette(base);
}

#DarkMode QRadioButton::indicator::checked:disabled {
    background-color: qradialgradient(cx:0.5, cy:0.5, fx:0.5, fy:0.5, radius:.4, stop:.65 rgb(136, 136, 136), stop:.75 transparent);
    border: 2px solid rgb(136, 136, 136);
}

#DarkMode QScrollArea {
    background-color: transparent;
    border: none;
}

#DarkMode QScrollArea > QWidget > QWidget {
    background-color: transparent;
}

#DarkMode QScrollBar {
    background-color: transparent;
}

#DarkMode QScrollBar:vertical {
    padding-top: 6px;
    padding-bottom: 6px;
    width: 16px;
}

#DarkMode QScrollBar::handle {
    background-color: rgba(255, 255, 255, 31);
    border-radius: 8px;
}

#DarkMode QScrollBar::add-line {
    border: none;
}

#DarkMode QScrollBar::sub-line {
    border: none;
}

#DarkMode QLineEdit {
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 1px;
    border-bottom-right-radius: 1px;
    border: none;
    padding: 12px;
    color: rgb(255, 255, 255);
    background-color: rgb(25, 25, 25);
    border-bottom: 1px solid rgb(66, 66, 66);
}

#DarkMode QLineEdit:focus {
    background-color: rgb(29, 29, 29);
    border-bottom: 2px solid palette(base);
}

#DarkMode Switch {
    qproperty-track_color: rgba(255, 255, 255, 31);
    qproperty-thumb_color: rgb(158, 158, 158);
}

#DarkMode Tuner {
    qproperty-color: rgb(224, 224, 224);
    qproperty-accent: palette(base);
}

#DarkMode Tuner::groove {
    background-color: none;
}

#DarkMode Tuner::handle {
    background-color: none;
    width: 0px;
    height: 0px;
}

#DarkMode Tuner::sub-page {
    background-color: none;
}

#DarkMode StepMeter {
    qproperty-base_color: palette(alternate-base);
    qproperty-bar_color: palette(base);
}

#DarkMode ClimateState {
    qproperty-color: rgb(228, 228, 228);
}

#DarkMode VehicleState {
    qproperty-base_color: rgb(228, 228, 228);
    qproperty-headlight_color: #4FC3F7;
    qproperty-taillight_color: #E57373;
    qproperty-indicator_color: #FFB74D;
    qproperty-warning_color: #FF7043;
}

#DarkMode Dialog,
#DarkMode Dialog > QFrame {
    background-color: rgb(56, 56, 56);
    border-radius: 8px;
    border: 2px solid rgb(66, 66, 66);
}

#DarkMode #ControlBar {
    background-color: rgb(48, 48, 48);
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}

#DarkMode #StatusBar {
    background-color: rgba(255, 255, 255, 4);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-bottom-right-radius: 4px;
    margin: 2px;
}

#DarkMode *[add_hint="true"] {
    background-color: rgba(255, 255, 255, 31);
    border-radius: 8px;
}

#DarkMode *[focusByTab="true"]:focus{
    outline: 2px solid palette(base);
    margin:-8px;
}
#DarkMode QSlider::handle:focus {
    border:2px solid rgba(255, 255, 255);
    margin-top: -10px;
    margin-left:0px;
    margin-right:0px;
    margin-bottom: -10px;
    outline: none;
    width: 21px;
    height: 5px;
}
